generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  Active
  Inactive
}

enum UserRoleEnum {
  Manager
  Doctor
  Admin
}

enum Gender {
  Male
  Female
  Other
}

enum PatientCategory {
  BHYT
  DichVu
  UuTien
}

enum PregnancyStatus {
  None
  Yes
  Unknown
  Breastfeeding
}

enum PaymentStatus {
  Unpaid
  Paid
}

enum NodeType {
  CATEGORY
  TYPE
}

enum InputType {
  Text
  Number
  Select
  Boolean
  LongText
}

enum Session {
  Morning
  Afternoon
  Evening
}

enum InventoryLogType {
  Import
  Export
  Adjustment
}

model Role {
  roleId   String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roleName UserRoleEnum @unique

  users UserRole[]
}

model Clinic {
  clinicId   String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clinicName String? @db.VarChar(255)
  address    String? @db.VarChar(255)
  phone      String? @db.VarChar(255)
  email      String  @unique @db.VarChar(150)
  clinicCode String? @unique @default(dbgenerated("generate_clinic_code()")) @db.VarChar(100)

  users User[]

  patients       Patient[]
  medicines      Medicine[]
  medicalRecords MedicalRecord[]
}

model User {
  userId    String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  username  String     @unique @db.VarChar(100)
  password  String     @db.VarChar(255)
  fullName  String     @db.VarChar(200)
  email     String?    @unique @db.VarChar(150)
  status    UserStatus @default(Active)
  createdAt DateTime   @default(now()) @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz

  clinicId String? @db.Uuid
  clinic   Clinic? @relation(fields: [clinicId], references: [clinicId])

  roles                 UserRole[]
  medicalRecords        MedicalRecord[]
  prescriptionTemplates PrescriptionTemplate[]
  serviceRequests       ServiceRequest[]
  inventoryLogs         InventoryLog[]
  refreshTokens         RefreshToken[]
  examinationsPerformed ClinicalExamination[]  @relation("ExaminedByUser")
  clinicalExaminations  ClinicalExamination[]
}

model RefreshToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token     String   @unique @db.VarChar(500)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  isRevoked Boolean  @default(false)

  @@index([userId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Patient {
  patientId       String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patientCode     String?           @unique
  fullName        String?
  gender          Gender?
  dob             DateTime?         @db.Timestamptz
  patientCategory PatientCategory?  @default(DichVu)
  phone           String?           @unique
  email           String?
  identityCard    String?           @unique
  insuranceNumber String?           @unique
  occupation      String?
  address         String?
  createdAt       DateTime?         @default(now()) @db.Timestamptz
  updatedAt       DateTime?         @updatedAt @db.Timestamptz
  relatives       PatientRelative[]
  medicalRecords  MedicalRecord[]
  allergies       PatientAllergy[]
  clinic          Clinic?           @relation(fields: [clinicId], references: [clinicId])
  clinicId        String?           @db.Uuid
}

model PatientRelative {
  relativeId   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patientId    String?  @db.Uuid
  patient      Patient? @relation(fields: [patientId], references: [patientId])
  fullName     String?
  phone        String?
  relationship String?
  identityCard String?
  address      String?
}

model PatientAllergy {
  allergyId String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  patientId String   @unique @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [patientId])
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz
}

model MedicalRecord {
  recordId               String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recordCode             String?              @unique @default(dbgenerated("generate_record_code()"))
  patientId              String?              @db.Uuid
  patient                Patient?             @relation(fields: [patientId], references: [patientId])
  doctorId               String?              @db.Uuid
  doctor                 User?                @relation(fields: [doctorId], references: [userId])
  diagnoses              Json?
  evidenceBasedDiagnosis Boolean?             @default(false)
  doctorAdvice           String?
  treatmentNote          String?
  consultationFee        Decimal?             @default(0)
  createdAt              DateTime?            @default(now()) @db.Timestamptz
  updatedAt              DateTime?            @updatedAt @db.Timestamptz
  clinicalExamination    ClinicalExamination?
  prescription           Prescription?
  followUp               FollowUp?
  serviceRequests        ServiceRequest[]
  clinic                 Clinic?              @relation(fields: [clinicId], references: [clinicId])
  clinicId               String?              @db.Uuid
}

model MedicalRecordSequence {
  monthKey   String @id @db.VarChar(4)
  currentVal Int    @default(0)
}

model ClinicalExamination {
  examId              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recordId            String?          @unique @db.Uuid
  medicalRecord       MedicalRecord?   @relation(fields: [recordId], references: [recordId])
  reasonForVisit      String?
  medicalHistory      String?
  pastMedicalHistory  String?
  heartRate           Int?
  bloodPressure       String?
  temperature         Float?
  height              Float?
  weight              Float?
  clinicalExamination String?
  pregnancyStatus     PregnancyStatus? @default(None)
  pregnancyWeeks      Int?
  clinicalNotes       String?
  examinedAt          DateTime?        @default(now()) @db.Timestamptz
  examinedBy          String?          @db.Uuid
  examiner            User?            @relation("ExaminedByUser", fields: [examinedBy], references: [userId])
  userId              String?          @db.Uuid
  user                User?            @relation(fields: [userId], references: [userId])
}

model Icd10Dictionary {
  code        String  @id
  description String?
}

model Prescription {
  prescriptionId String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recordId       String?              @unique @db.Uuid
  medicalRecord  MedicalRecord?       @relation(fields: [recordId], references: [recordId])
  pdfPath        String?
  fileName       String?
  note           String?
  totalPrice     Decimal?
  paymentStatus  PaymentStatus?       @default(Unpaid)
  createdAt      DateTime?            @default(now()) @db.Timestamptz
  details        PrescriptionDetail[]
}

model PrescriptionDetail {
  detailId            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  prescriptionId      String?       @db.Uuid
  prescription        Prescription? @relation(fields: [prescriptionId], references: [prescriptionId])
  medicineId          String?       @db.Uuid
  medicine            Medicine?     @relation(fields: [medicineId], references: [medicineId])
  unit                String?
  frequencyPerDay     Int?
  quantityPerTime     Float?
  administrationRoute String?
  timing              String?
  quantity            Int?
  daysToTake          Int?
  price               Float?
  isInsuranceCovered  Boolean?      @default(false)
  appliedExportPrice  Decimal?
  note                String?
}

model FollowUp {
  followUpId      String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recordId        String?        @unique @db.Uuid
  medicalRecord   MedicalRecord? @relation(fields: [recordId], references: [recordId])
  appointmentDate DateTime?      @db.Date
  session         Session?
  reason          String?
}

model ServiceNode {
  nodeId   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nodeType NodeType?
  parentId String?       @db.Uuid
  parent   ServiceNode?  @relation("NodeHierarchy", fields: [parentId], references: [nodeId])
  children ServiceNode[] @relation("NodeHierarchy")

  code     String?  @unique
  name     String?
  note     String?
  isActive Boolean? @default(true)

  itemsAsCategory ServiceItem[] @relation("CategoryNode")
  itemsAsType     ServiceItem[] @relation("TypeNode")
}

model ServiceItem {
  itemId   String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  itemCode String? @unique
  name     String?

  categoryId String?      @db.Uuid
  category   ServiceNode? @relation("CategoryNode", fields: [categoryId], references: [nodeId])
  typeId     String?      @db.Uuid
  type       ServiceNode? @relation("TypeNode", fields: [typeId], references: [nodeId])
  basePrice  Decimal?
  unit       String?
  specimen   String?
  prepNote   String?
  isActive   Boolean?     @default(true)

  configs         ServiceItemConfig[]
  requestDetails  ServiceRequestDetail[]
  templateDetails ServiceTemplateDetail[]
  serviceResults  ServiceResult[]
}

model ServiceItemConfig {
  configId    String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  itemId      String?      @db.Uuid
  serviceItem ServiceItem? @relation(fields: [itemId], references: [itemId])

  configCode     String?
  displayName    String?
  inputType      InputType?      @default(Text)
  unit           String?
  metaData       Json?
  refRange       String?
  serviceResults ServiceResult[]
}

model ServiceRequest {
  requestId     String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestCode   String         @unique @default(dbgenerated())
  recordId      String?        @db.Uuid
  medicalRecord MedicalRecord? @relation(fields: [recordId], references: [recordId])

  orderingDoctorId      String?   @db.Uuid
  orderingDoctor        User?     @relation(fields: [orderingDoctorId], references: [userId])
  diagnoses             Json?
  isPatientRequested    Boolean   @default(false)
  receiveResultAtClinic Boolean   @default(false)
  isForFollowUp         Boolean   @default(false)
  note                  String?
  createdAt             DateTime? @default(now()) @db.Timestamptz
  updatedAt             DateTime? @default(now()) @db.Timestamptz
  finalReportPath       String?

  details        ServiceRequestDetail[]
  serviceResults ServiceResult[]
}

model ServiceRequestDetail {
  requestDetailId String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestId       String?         @db.Uuid
  serviceRequest  ServiceRequest? @relation(fields: [requestId], references: [requestId])

  itemId      String?      @db.Uuid
  serviceItem ServiceItem? @relation(fields: [itemId], references: [itemId])

  selectedOptions Json?
}

model ServiceResult {
  resultId String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  detailId       String?         @db.Uuid
  requestId      String?         @db.Uuid
  serviceRequest ServiceRequest? @relation(fields: [requestId], references: [requestId])

  itemId      String?      @db.Uuid
  serviceItem ServiceItem? @relation(fields: [itemId], references: [itemId])

  configId          String?            @db.Uuid
  serviceItemConfig ServiceItemConfig? @relation(fields: [configId], references: [configId])

  parentId      String?         @db.Uuid
  parent        ServiceResult?  @relation("ResultHierarchy", fields: [parentId], references: [resultId])
  children      ServiceResult[] @relation("ResultHierarchy")
  indicatorName String?

  valueString String?  @db.Text
  valueNumber Decimal? @db.Decimal(10, 2)

  unit       String?
  images     Json?
  executedAt DateTime? @default(now()) @db.Timestamptz
}

model ServiceTemplate {
  templateId   String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  templateName String?
  description  String?
  isActive     Boolean?                @default(true)
  details      ServiceTemplateDetail[]
}

model ServiceTemplateDetail {
  templateDetailId String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  templateId       String?          @db.Uuid
  template         ServiceTemplate? @relation(fields: [templateId], references: [templateId])
  itemId           String?          @db.Uuid
  serviceItem      ServiceItem?     @relation(fields: [itemId], references: [itemId])
  configSelections Json?
  note             String?
}

model Medicine {
  medicineId          String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  medicineCode        String?                      @unique
  medicineName        String?
  activeIngredient    String?
  registrationNo      String?
  isInsuranceCovered  Boolean?                     @default(false)
  medicineCodeBhyt    String?
  insurancePrice      Decimal?
  baseUnit            String?
  totalQuantity       Int?                         @default(0)
  sellPrice           Decimal?
  note                String?
  supplier            String?
  sideEffects         String?
  isActive            Boolean?                     @default(true)
  createdAt           DateTime?                    @default(now()) @db.Timestamptz
  prescriptionDetails PrescriptionDetail[]
  templateDetails     PrescriptionTemplateDetail[]
  inventoryLogs       InventoryLog[]
  clinic              Clinic?                      @relation(fields: [clinicId], references: [clinicId])
  clinicId            String?                      @db.Uuid
}

model InventoryLog {
  logId        String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  medicineId   String?           @db.Uuid
  medicine     Medicine?         @relation(fields: [medicineId], references: [medicineId])
  type         InventoryLogType?
  quantity     Int?
  quantityBase Int?
  unitPrice    Decimal?
  totalPrice   Decimal?
  performedBy  String?           @db.Uuid
  performer    User?             @relation(fields: [performedBy], references: [userId])
  note         String?
  createdAt    DateTime?         @default(now()) @db.Timestamptz
}

model PrescriptionTemplate {
  templateId   String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  templateName String
  description  String?
  createdBy    String?                      @db.Uuid
  creator      User?                        @relation(fields: [createdBy], references: [userId])
  details      PrescriptionTemplateDetail[]
}

model PrescriptionTemplateDetail {
  templateDetailId       String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  templateId             String                @db.Uuid
  template               PrescriptionTemplate? @relation(fields: [templateId], references: [templateId])
  medicineId             String                @db.Uuid
  medicine               Medicine              @relation(fields: [medicineId], references: [medicineId])
  defaultFrequency       Int?
  defaultQuantityPerTime Float?
  daysToTake             Int?
  defaultRoute           String?
  defaultTiming          String?
}

model File {
  FileID String @id @default(dbgenerated("uuid_generate_v4()"))

  RelativePath String
  Type         String
  MimeType     String

  Size      Int
  CreatedAt DateTime @default(now()) @db.Timestamptz
}
