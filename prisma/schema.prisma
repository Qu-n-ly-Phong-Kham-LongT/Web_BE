generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  Active
  Inactive
}

enum UserRoleEnum {
  Manager
  Doctor
  Admin
  Staff
}

enum Gender {
  Male
  Female
  Other
}

enum PatientCategory {
  BHYT
  DichVu
  UuTien
}

enum PregnancyStatus {
  None
  Yes
  Unknown
  Breastfeeding
}

enum PaymentStatus {
  Unpaid
  Paid
}

enum NodeType {
  CATEGORY
  TYPE
}

enum InputType {
  Boolean
  Text
  Select
}

enum Session {
  Morning
  Afternoon
  Evening
}

enum InventoryLogType {
  Import
  Export
  Adjustment
  Return
}

model Role {
  RoleID   String        @id @default(uuid()) @db.Uuid
  RoleName UserRoleEnum

  users    UserRole[]

  @@unique([RoleName])
  @@map("Roles")
}

model User {
  UserID    String     @id @default(uuid()) @db.Uuid
  Username  String     @unique @db.VarChar(100)
  Password  String     @db.VarChar(255)
  FullName  String     @db.VarChar(200)
  Email     String?    @unique @db.VarChar(150)
  Status    UserStatus @default(Active)
  CreatedAt DateTime   @default(now()) @map("Created_At")
  UpdatedAt DateTime   @updatedAt @map("Updated_At")

  roles                 UserRole[]
  medicalRecords        MedicalRecord[]
  prescriptionTemplates PrescriptionTemplate[]
  serviceRequests       ServiceRequest[]
  serviceResults        ServiceResult[]
  inventoryLogs         InventoryLog[]

  @@map("Users")
}

model UserRole {
  UserID String @db.Uuid
  RoleID String @db.Uuid

  user User @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
  role Role @relation(fields: [RoleID], references: [RoleID], onDelete: Restrict)

  @@id([UserID, RoleID])
  @@index([UserID])
  @@index([RoleID])
  @@map("UserRoles")
}

model Patient {
  PatientID       String            @id @default(uuid()) @db.Uuid
  PatientCode     String?           @unique
  FullName        String?
  Gender          Gender?
  DOB             DateTime?
  PatientCategory PatientCategory?  @default(DichVu)
  Phone           String?           @unique
  Email           String?
  IdentityCard    String?           @unique
  InsuranceNumber String?           @unique
  Occupation      String?
  Address         String?
  CreatedAt       DateTime?         @default(now()) @map("Created_At")
  UpdatedAt       DateTime?         @updatedAt @map("Updated_At")
  relatives       PatientRelative[]
  medicalRecords  MedicalRecord[]

  @@map("Patients")
}

model PatientRelative {
  RelativeID   String   @id @default(uuid()) @db.Uuid
  PatientID    String?  @db.Uuid
  patient      Patient? @relation(fields: [PatientID], references: [PatientID])
  FullName     String?
  Phone        String?
  Relationship String?
  IdentityCard String?  @unique
  Address      String?

  @@map("PatientRelatives")
}

model MedicalRecord {
  RecordID               String               @id @default(uuid()) @db.Uuid
  RecordCode             String?              @unique
  PatientID              String?              @db.Uuid
  patient                Patient?             @relation(fields: [PatientID], references: [PatientID])
  DoctorID               String?              @db.Uuid
  doctor                 User?                @relation(fields: [DoctorID], references: [UserID])
  Diagnoses              Json?
  EvidenceBasedDiagnosis Boolean?             @default(false)
  DoctorAdvice           String?
  TreatmentNote          String?
  ConsultationFee        Decimal?             @default(0)
  Created_At             DateTime?            @default(now())
  Updated_At             DateTime?            @updatedAt
  clinicalExamination    ClinicalExamination?
  prescription           Prescription?
  followUp               FollowUp?
  serviceRequests        ServiceRequest[]

  @@map("MedicalRecords")
}

model ClinicalExamination {
  ExamID              String           @id @default(uuid()) @db.Uuid
  RecordID            String?          @unique @db.Uuid
  medicalRecord       MedicalRecord?   @relation(fields: [RecordID], references: [RecordID])
  ReasonForVisit      String?
  MedicalHistory      String?
  PastMedicalHistory  String?
  HeartRate           Int?
  BloodPressure       String?
  Temperature         Float?
  Height              Float?
  Weight              Float?
  ClinicalExamination String?
  PregnancyStatus     PregnancyStatus? @default(None)
  PregnancyWeeks      Int?
  DrugAllergies       String?
  ClinicalNotes       String?
  ExaminedAt          DateTime?        @default(now())
  ExaminedBy          String?          @db.Uuid

  @@map("ClinicalExaminations")
}

model ICD10_Dictionary {
  Code        String  @id
  Description String?
}

model Prescription {
  PrescriptionID String               @id @default(uuid()) @db.Uuid
  RecordID       String?              @unique @db.Uuid
  medicalRecord  MedicalRecord?       @relation(fields: [RecordID], references: [RecordID])
  PdfPath        String?
  FileName       String?
  Note           String?
  TotalPrice     Decimal?
  PaymentStatus  PaymentStatus?       @default(Unpaid)
  Created_At     DateTime?            @default(now())
  details        PrescriptionDetail[]

  @@map("Prescriptions")
}

model PrescriptionDetail {
  DetailID            String        @id @default(uuid()) @db.Uuid
  PrescriptionID      String?       @db.Uuid
  prescription        Prescription? @relation(fields: [PrescriptionID], references: [PrescriptionID])
  MedicineID          String?       @db.Uuid
  medicine            Medicine?     @relation(fields: [MedicineID], references: [MedicineID])
  Unit                String?
  FrequencyPerDay     Int?
  QuantityPerTime     Float?
  AdministrationRoute String?
  Timing              String?
  Quantity            Int?
  DaysToTake          Int?
  Price               Float?
  IsInsuranceCovered  Boolean?      @default(false)
  AppliedExportPrice  Decimal?
  Note                String?

  @@map("PrescriptionDetails")
}

model PrescriptionTemplate {
  TemplateID   String                       @id @default(uuid()) @db.Uuid
  TemplateName String?
  Description  String?
  CreatedBy    String?                      @db.Uuid
  creator      User?                        @relation(fields: [CreatedBy], references: [UserID])
  details      PrescriptionTemplateDetail[]

  @@map("PrescriptionTemplates")
}

model PrescriptionTemplateDetail {
  TemplateDetailID       String                @id @default(uuid()) @db.Uuid
  TemplateID             String?               @db.Uuid
  template               PrescriptionTemplate? @relation(fields: [TemplateID], references: [TemplateID])
  MedicineID             String?               @db.Uuid
  medicine               Medicine?             @relation(fields: [MedicineID], references: [MedicineID])
  DefaultFrequency       Int?
  DefaultQuantityPerTime Float?
  DefaultRoute           String?
  DefaultTiming          String?

  @@map("PrescriptionTemplateDetails")
}

model FollowUp {
  FollowUpID      String         @id @default(uuid()) @db.Uuid
  RecordID        String?        @unique @db.Uuid
  medicalRecord   MedicalRecord? @relation(fields: [RecordID], references: [RecordID])
  AppointmentDate DateTime?      @db.Date
  Session         Session?
  Reason          String?

  @@map("FollowUps")
}

model ServiceNode {
  NodeID          String        @id @default(uuid()) @db.Uuid
  NodeType        NodeType?
  ParentID        String?       @db.Uuid
  parent          ServiceNode?  @relation("NodeHierarchy", fields: [ParentID], references: [NodeID])
  children        ServiceNode[] @relation("NodeHierarchy")
  Code            String?       @unique
  Name            String?
  Note            String?
  IsActive        Boolean?      @default(true)
  itemsAsCategory ServiceItem[] @relation("CategoryNode")
  itemsAsType     ServiceItem[] @relation("TypeNode")

  @@map("ServiceNodes")
}

model ServiceItem {
  ItemID          String                  @id @default(uuid()) @db.Uuid
  ItemCode        String?                 @unique
  Name            String?
  CategoryID      String?                 @db.Uuid
  category        ServiceNode?            @relation("CategoryNode", fields: [CategoryID], references: [NodeID])
  TypeID          String?                 @db.Uuid
  type            ServiceNode?            @relation("TypeNode", fields: [TypeID], references: [NodeID])
  Unit            String?
  Specimen        String?
  PrepNote        String?
  IsActive        Boolean?                @default(true)
  configs         ServiceItemConfig[]
  requestDetails  ServiceRequestDetail[]
  templateDetails ServiceTemplateDetail[]

  @@map("ServiceItems")
}

model ServiceItemConfig {
  ConfigID    String       @id @default(uuid()) @db.Uuid
  ItemID      String?      @db.Uuid
  serviceItem ServiceItem? @relation(fields: [ItemID], references: [ItemID])
  ConfigCode  String?
  DisplayName String?
  InputType   InputType?   @default(Boolean)
  GroupName   String?
  MetaData    Json?

  @@map("ServiceItemConfigs")
}

model ServiceRequest {
  RequestID        String                 @id @default(uuid()) @db.Uuid
  RequestCode      String?                @unique
  RecordID         String?                @db.Uuid
  medicalRecord    MedicalRecord?         @relation(fields: [RecordID], references: [RecordID])
  OrderingDoctorID String?                @db.Uuid
  orderingDoctor   User?                  @relation(fields: [OrderingDoctorID], references: [UserID])
  Note             String?
  CreatedAt        DateTime?              @default(now())
  details          ServiceRequestDetail[]

  @@map("ServiceRequests")
}

model ServiceRequestDetail {
  RequestDetailID String          @id @default(uuid()) @db.Uuid
  RequestID       String?         @db.Uuid
  serviceRequest  ServiceRequest? @relation(fields: [RequestID], references: [RequestID])
  ItemID          String?         @db.Uuid
  serviceItem     ServiceItem?    @relation(fields: [ItemID], references: [ItemID])
  SelectedOptions Json?
  result          ServiceResult?

  @@map("ServiceRequestDetails")
}

model ServiceResult {
  ResultID           String                @id @default(uuid()) @db.Uuid
  DetailID           String?               @unique @db.Uuid
  requestDetail      ServiceRequestDetail? @relation(fields: [DetailID], references: [RequestDetailID])
  ResultCode         String?
  Description        String?
  Conclusion         String?
  Note               String?
  IsPDF              Boolean?              @default(false)
  PdfUrl             String?
  PerformingDoctorID String?               @db.Uuid
  performingDoctor   User?                 @relation(fields: [PerformingDoctorID], references: [UserID])
  ExecutedAt         DateTime?

  @@map("ServiceResults")
}

model ServiceTemplate {
  TemplateID   String                  @id @default(uuid()) @db.Uuid
  TemplateName String?
  Description  String?
  CreatedBy    String?                 @db.Uuid
  IsActive     Boolean?                @default(true)
  details      ServiceTemplateDetail[]

  @@map("ServiceTemplates")
}

model ServiceTemplateDetail {
  TemplateDetailID String           @id @default(uuid()) @db.Uuid
  TemplateID       String?          @db.Uuid
  template         ServiceTemplate? @relation(fields: [TemplateID], references: [TemplateID])
  ItemID           String?          @db.Uuid
  serviceItem      ServiceItem?     @relation(fields: [ItemID], references: [ItemID])
  Note             String?

  @@map("ServiceTemplateDetails")
}

model Medicine {
  MedicineID          String                       @id @default(uuid()) @db.Uuid
  MedicineCode        String?                      @unique
  MedicineName        String?
  ActiveIngredient    String?
  IsInsuranceCovered  Boolean?                     @default(false)
  MedicineCodeBHYT    String?
  InsurancePrice      Decimal?
  BaseUnit            String?
  TotalQuantity       Int?                         @default(0)
  SellPrice           Decimal?
  Note                String?
  Supplier            String?
  SideEffects         String?
  IsActive            Boolean?                     @default(true)
  CreatedAt           DateTime?                    @default(now())
  prescriptionDetails PrescriptionDetail[]
  templateDetails     PrescriptionTemplateDetail[]
  inventoryLogs       InventoryLog[]

  @@map("Medicines")
}

model InventoryLog {
  LogID        String            @id @default(uuid()) @db.Uuid
  MedicineID   String?           @db.Uuid
  medicine     Medicine?         @relation(fields: [MedicineID], references: [MedicineID])
  Type         InventoryLogType?
  Quantity     Int?
  QuantityBase Int?
  UnitPrice    Decimal?
  TotalPrice   Decimal?
  PerformedBy  String?           @db.Uuid
  performer    User?             @relation(fields: [PerformedBy], references: [UserID])
  Note         String?
  CreatedAt    DateTime?         @default(now())

  @@map("InventoryLogs")
}
